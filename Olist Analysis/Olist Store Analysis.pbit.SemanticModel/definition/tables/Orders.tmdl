	column OrderDate
		dataType: dateTime
		formatString: General Date
		lineageTag: 2ba6a721-0628-411b-b862-7b6ed82fed00
		summarizeBy: none
		sourceColumn: OrderDate

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column DeliveryDaysBucketSort =
			
			VAR Days = DATEDIFF(Orders[order_purchase_timestamp], Orders[order_delivered_customer_date], DAY)
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Orders[order_delivered_customer_date]), 99,
			        Days <= 5, 1,
			        Days <= 10, 2,
			        Days <= 15, 3,
			        Days <= 20, 4,
			        Days <= 30, 5,
			        6
			    )
		formatString: 0
		lineageTag: 47b502a2-c0a0-4616-9f61-51f0ff4d8b53
		summarizeBy: sum

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column DeliveryDaysBucket =
			
			VAR Days = DATEDIFF(Orders[order_purchase_timestamp], Orders[order_delivered_customer_date], DAY)
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Orders[order_delivered_customer_date]), "Not delivered",
			        Days <= 5, "0-5 days",
			        Days <= 10, "6-10 days",
			        Days <= 15, "11-15 days",
			        Days <= 20, "16-20 days",
			        Days <= 30, "21-30 days",
			        "30+ days"
			    )
		lineageTag: b73fb5eb-c1cb-4ad3-9fc4-98053e0d78b2
		summarizeBy: none
		sortByColumn: DeliveryDaysBucketSort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column DaysSincePreviousOrder = ```
			
			VAR CurrentCustomer = RELATED(Customers[customer_unique_id])
			VAR CurrentTimestamp = Orders[order_purchase_timestamp]
			VAR PreviousTimestamp =
			    CALCULATE(
			        MAX(Orders[order_purchase_timestamp]),
			        FILTER(
			            ALL(Orders),
			            RELATED(Customers[customer_unique_id]) = CurrentCustomer &&
			            Orders[order_purchase_timestamp] < CurrentTimestamp
			        )
			    )
			RETURN
			    IF(ISBLANK(PreviousTimestamp), BLANK(), DATEDIFF(PreviousTimestamp, CurrentTimestamp, DAY))
			// DaysSincePreviousOrder = 
			// VAR CurrentCustomer = RELATED(Customers[customer_unique_id])
			// VAR CurrentDate = Orders[OrderDate]
			// VAR PreviousDate =
			//     CALCULATE(
			//         MAX(Orders[OrderDate]),
			//         FILTER(
			//             ALL(Orders),
			//             RELATED(Customers[customer_unique_id]) = CurrentCustomer &&
			//             Orders[OrderDate] < CurrentDate
			//         )
			//     )
			// RETURN
			//     IF(ISBLANK(PreviousDate), BLANK(), DATEDIFF(PreviousDate, CurrentDate, DAY))
			```
		formatString: 0
		lineageTag: 87318092-6276-4855-b908-5ab3cdad5ab1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DaysSinceGapBucket =
			
			SWITCH(
			    TRUE(),
			    ISBLANK(Orders[DaysSincePreviousOrder]), "First order",
			    Orders[DaysSincePreviousOrder] = 0, "Same day (0 days)",
			    Orders[DaysSincePreviousOrder] <= 7, "1-7 days",
			    Orders[DaysSincePreviousOrder] <= 30, "8-30 days",
			    Orders[DaysSincePreviousOrder] <= 90, "31-90 days",
			    "90+ days"
			)
		lineageTag: 003f7f99-7432-4d66-8ef1-295c25310f5d
		summarizeBy: none
		sortByColumn: DaysSinceGapBucketSort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column DaysSinceGapBucketSort =
			
			SWITCH(
			    TRUE(),
			    ISBLANK(Orders[DaysSincePreviousOrder]), 99,
			    Orders[DaysSincePreviousOrder] = 0, 1,
			    Orders[DaysSincePreviousOrder] <= 7, 2,
			    Orders[DaysSincePreviousOrder] <= 30, 3,
			    Orders[DaysSincePreviousOrder] <= 90, 4,
			    5
			)
		formatString: 0
		lineageTag: 5513dd81-7039-45cf-bb26-667d2cecffc1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

