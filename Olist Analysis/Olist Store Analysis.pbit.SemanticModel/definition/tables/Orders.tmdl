table Orders
	lineageTag: 65aee7ba-47d4-45e6-aca9-234d36cc180a

	measure 'Total Revenue' = SUM('Order Items'[price])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 23f4ebfc-2b23-402f-9b77-4b5b068d1bd5

	measure 'Total Freight' = SUM('Order Items'[freight_value])
		lineageTag: 02edb46c-3558-4930-9334-bd05d0a8b630

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' = DISTINCTCOUNT(Orders[order_id])
		formatString: 0
		lineageTag: 0a11ffe4-7a4d-4ec9-9517-b853cd1eab0f

	measure 'Total Customers' = DISTINCTCOUNT(Customers[customer_unique_id])
		formatString: 0
		lineageTag: e3bd26b2-d258-4776-a1a5-cace22e49cc1

	measure 'Total Sellers' = DISTINCTCOUNT(Sellers[seller_id])
		formatString: 0
		lineageTag: ccb3101f-920d-4ebc-9cd5-595efa12cca6

	measure 'Avg Order Value' = DIVIDE([Total Revenue], [Total Orders])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e6f0e593-272b-40a2-9e7a-820533d25cd9

	measure 'Freight % of Price (Avg per Item)' =
			
			AVERAGEX(
			    'Order Items',
			    DIVIDE('Order Items'[freight_value], 'Order Items'[price])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: dee67d6e-510d-485a-a5ad-b05d24127234

	measure 'Delivered Rate' =
			
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(Orders[order_id]), Orders[order_status] = "Delivered"),
			    [Total Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: af26d255-f73e-4ca6-845c-9b2fcc2d87a7

	measure 'Cancellation Rate' =
			
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(Orders[order_id]), Orders[order_status] = "Canceled"),
			    [Total Orders]
			)
		lineageTag: 3f74066d-fcc9-416e-aa36-8ea240d2354b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Delivery Days' =
			
			AVERAGEX(
			    FILTER(Orders, NOT ISBLANK(Orders[order_delivered_customer_date])),
			    DATEDIFF(Orders[order_purchase_timestamp], Orders[order_delivered_customer_date], DAY)
			)
		lineageTag: ec08d828-c23e-4000-bce5-a3d3dfeac10b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Late Delivery Rate' =
			
			VAR DeliveredOrders = FILTER(Orders, NOT ISBLANK(Orders[order_delivered_customer_date]))
			VAR LateOrders = FILTER(DeliveredOrders, Orders[order_delivered_customer_date] > Orders[order_estimated_delivery_date])
			RETURN DIVIDE(COUNTROWS(LateOrders), COUNTROWS(DeliveredOrders))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7d96fc40-2a49-4490-91f4-ee789795886f

	measure 'Avg Review Score' = AVERAGE('Order Reviews'[review_score])
		formatString: 0.0
		lineageTag: 94b81b68-dc53-410a-8478-25161a1500ec

	measure 'Repeat Purchase Rate (Naive, Inflated)' =
			
			VAR CustomerOrderCounts =
			    ADDCOLUMNS(
			        SUMMARIZE(Orders, Customers[customer_unique_id]),
			        "OrderCount", CALCULATE(DISTINCTCOUNT(Orders[order_id]))
			    )
			VAR RepeatCustomers = COUNTROWS(FILTER(CustomerOrderCounts, [OrderCount] > 1))
			RETURN DIVIDE(RepeatCustomers, COUNTROWS(CustomerOrderCounts))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 33fcbcdc-1c31-4a4c-a483-20f759f3c949

	measure 'Repeat Purchase Rate (Corrected)' =
			
			VAR CustomerDayCounts =
			    ADDCOLUMNS(
			        SUMMARIZE(Orders, Customers[customer_unique_id]),
			        "DistinctDays", CALCULATE(DISTINCTCOUNT(Orders[OrderDate]))
			    )
			VAR RepeatCustomers = COUNTROWS(FILTER(CustomerDayCounts, [DistinctDays] > 1))
			RETURN DIVIDE(RepeatCustomers, COUNTROWS(CustomerDayCounts))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bdc8c1d2-0490-4ed6-9c53-4d50773383d5

	measure 'Total Products' = DISTINCTCOUNT(Products[product_id])
		formatString: 0
		lineageTag: 8c6884f4-a2d8-4d35-b09a-4d117cb29c97

	measure 'Pct Same-Day Gaps' =
			
			VAR NonFirstOrders = FILTER(Orders, NOT ISBLANK(Orders[DaysSincePreviousOrder]))
			VAR SameDayOrders = FILTER(NonFirstOrders, Orders[DaysSincePreviousOrder] = 0)
			RETURN DIVIDE(COUNTROWS(SameDayOrders), COUNTROWS(NonFirstOrders))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 60e61319-dbe7-473e-abbe-8748b55debe9

